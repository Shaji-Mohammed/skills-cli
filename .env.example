# Copy to .env (git-ignored) and fill in.

# Local LLM used for curation and, later, the scorer and fallback stages.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Hard spend cap in USD across all paid API calls (e.g. Jev, once we have a key).
SPEND_LIMIT_USD=5.00

# Runs whose estimated cost exceeds this need explicit confirmation (--yes).
SPEND_CONFIRM_USD=0.50
